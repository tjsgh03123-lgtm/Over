{
  "expo": {
    "name": "OVERDRIVE",
    "slug": "overdrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D10",
    "android": {
      "package": "com.overdrive.workout",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "운동 영상을 촬영하려면 카메라 접근이 필요합니다.",
          "microphonePermission": false,
          "photosPermission": false
        }
      ]
    ]
  }
}
